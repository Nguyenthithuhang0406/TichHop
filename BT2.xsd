<?xml version="1.0" encoding="utf-8"?>
<xs:schema targetNamespace="http://tempuri.org/XMLSchema.xsd"
    elementFormDefault="qualified"
    xmlns="http://tempuri.org/XMLSchema.xsd"
    xmlns:mstns="http://tempuri.org/XMLSchema.xsd"
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>
	<xs:element name="DS">
		<xs:complexType>
			<xs:sequence>
				<!--Toi da 10 hoa don-->
				<xs:element name="HoaDon" maxOccurs="4">
					<xs:complexType>
						<xs:sequence>
							<xs:element name="MaHD" type="xs:string"/>
							<xs:element name="NgayBan" type="xs:date"/>
							<!--Toi da 10 loai hang-->
							<xs:element name="LoaiHang" maxOccurs="10">
								<xs:complexType>
									<xs:sequence>
										<xs:element name="Hang" maxOccurs="unbounded">
											<xs:complexType>
												<xs:sequence>
													<xs:element name="TenHang" type="xs:string"/>
													<xs:element name="SoLuong" type="xs:integer"/>
													<xs:element name="DonViTinh">
														<xs:simpleType>
															<xs:restriction base="xs:string">
																<xs:enumeration value="gói"/>
																<xs:enumeration value="hộp"/>
																<xs:enumeration value="chiếc"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
													<xs:element name="DonGia">
														<xs:simpleType>
															<xs:restriction base="xs:decimal">
																<xs:minExclusive value="0"/>
															</xs:restriction>
														</xs:simpleType>
													</xs:element>
												</xs:sequence>
												<!--Ma hang duy nha, toi da 6 ky tu-->
												<xs:attribute name="MaHang" use="required">
													<xs:simpleType>
														<xs:restriction base="xs:string">
															<xs:maxLength value="6"/>
														</xs:restriction>
													</xs:simpleType>
												</xs:attribute>
												
											</xs:complexType>
										</xs:element>
									</xs:sequence>
									
									<!--Thuoc tinh loai hang-->
									<xs:attribute name="MaLoai" type="xs:string" use="required"/>
									<xs:attribute name="TenLoai" type="xs:string" use="required"/>
								</xs:complexType>
								<!--Ma hang la duy nhat-->
								<xs:unique name="unique_MaHang">
									<xs:selector xpath="mstns:Hang"/>
									<xs:field xpath="@MaHang"/>
								</xs:unique>
							</xs:element>
										
						</xs:sequence>
					</xs:complexType>
				</xs:element>
			</xs:sequence>
		</xs:complexType>
	</xs:element>
</xs:schema>
